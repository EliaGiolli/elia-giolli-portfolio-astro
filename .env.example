# EmailJS (contact form). Without these the form falls back to mailto:.
PUBLIC_EMAILJS_SERVICE_ID=your_service_id
PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Optional override of the GA4 ID set in src/shared/utils/constants.ts (production builds only).
PUBLIC_GA_MEASUREMENT_ID=

# Optional override of the Search Console token set in src/shared/utils/constants.ts.
PUBLIC_GOOGLE_SITE_VERIFICATION=
