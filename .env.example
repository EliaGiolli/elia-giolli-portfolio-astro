# EmailJS (contact form). Without these the form falls back to mailto:.
PUBLIC_EMAILJS_SERVICE_ID=your_service_id
PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = no analytics and no cookie banner.
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console, "HTML tag" verification method: only the content value.
PUBLIC_GOOGLE_SITE_VERIFICATION=
