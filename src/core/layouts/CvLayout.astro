---
import BaseHead, { type SeoProps } from "../../shared/components/BaseHead.astro";
import BrandLink from "../../shared/components/BrandLink.astro";
import CookieConsent from "../../shared/components/CookieConsent.astro";
import PageContainer from "../../shared/components/PageContainer.astro";
import SkipLink from "../../shared/components/SkipLink.astro";
import "../../styles/global.css";

type Props = SeoProps;
---

<html lang="it" class="scroll-smooth bg-bg motion-reduce:scroll-auto">
	<head>
		<BaseHead {...Astro.props} />
	</head>
	<body class="min-h-screen bg-bg text-text-body">
		<SkipLink />
		<header class="border-b border-line/60 print:hidden">
			<PageContainer class="flex min-h-18 flex-wrap items-center justify-between gap-x-6 gap-y-2">
				<BrandLink label="Elia Giolli, torna alla home" />
				<button
					type="button"
					class="inline-flex min-h-11 cursor-pointer items-center gap-2 font-semibold text-text transition-colors duration-200 hover:text-accent"
					x-data
					x-on:click="window.print()"
				>
					Stampa o salva in PDF
				</button>
			</PageContainer>
		</header>

		<slot />
		<CookieConsent />
		<script>
			import "../../shared/lib/alpine";
		</script>
	</body>
</html>
