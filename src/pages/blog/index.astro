---
import { getCollection } from "astro:content";
import MainLayout from "../../core/layouts/MainLayout.astro";
import PostListItem from "../../features/blog/PostListItem.astro";
import { publishedEntries } from "../../helpers";
import Breadcrumbs from "../../shared/components/Breadcrumbs.astro";
import PageContainer from "../../shared/components/PageContainer.astro";
import PageHeader from "../../shared/components/PageHeader.astro";
import ArrowLink from "../../shared/ui/ArrowLink.astro";
import EmptyState from "../../shared/ui/EmptyState.astro";
import ListCardList from "../../shared/ui/ListCardList.astro";

const posts = publishedEntries(await getCollection("blog"), import.meta.env.DEV);
---

<MainLayout
	title="Blog su SEO tecnica e analytics"
	description="Articoli di Elia Giolli su Technical SEO, Core Web Vitals, dati strutturati, Google Analytics 4 e Search Console, scritti da un ex front-end developer."
>
	<PageHeader
		kicker="Dal codice alla SERP"
		title="SEO tecnica e analytics, spiegate da uno sviluppatore"
		dek="Appunti di studio, esperimenti e casi pratici dal mio percorso da front-end developer a SEO specialist."
	>
		<Breadcrumbs slot="before" items={[{ name: "Home", href: "/" }, { name: "Blog", href: "/blog/" }]} />
	</PageHeader>

	<PageContainer as="section" aria-label="Elenco degli articoli">
		<div class="max-w-3xl">
			{posts.length > 0 ? (
				<ListCardList>
					{posts.map((post) => <PostListItem post={post} headingLevel="h2" showTags />)}
				</ListCardList>
			) : (
				<>
					<EmptyState message="Il primo articolo è in arrivo. Nel frattempo puoi leggere i case study." />
					<ArrowLink label="Vai ai case study" href="/case-studies/" />
				</>
			)}
		</div>
	</PageContainer>
</MainLayout>
