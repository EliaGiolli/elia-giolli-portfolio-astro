---
import { getCollection, render } from "astro:content";
import MainLayout from "../../core/layouts/MainLayout.astro";
import CaseStudySteps from "../../features/case-studies/CaseStudySteps.astro";
import { publishedEntries } from "../../helpers";
import Breadcrumbs from "../../shared/components/Breadcrumbs.astro";
import PageContainer from "../../shared/components/PageContainer.astro";
import PageHeader from "../../shared/components/PageHeader.astro";
import ArrowLink from "../../shared/ui/ArrowLink.astro";
import ChipList from "../../shared/ui/ChipList.astro";
import MetricList from "../../shared/ui/MetricList.astro";
import MetricTile from "../../shared/ui/MetricTile.astro";

export async function getStaticPaths() {
	const caseStudies = publishedEntries(await getCollection("caseStudies"), import.meta.env.DEV);

	return caseStudies.map((caseStudy) => ({
		params: { id: caseStudy.id },
		props: { caseStudy },
	}));
}

const { caseStudy } = Astro.props;
const { data } = caseStudy;
const { Content } = await render(caseStudy);
---

<MainLayout title={data.title} description={data.description} ogType="article" publishedTime={data.pubDate}>
	<article aria-labelledby="page-title">
		<PageHeader kicker="Case study" title={data.title} dek={data.description} width="prose">
			<Breadcrumbs
				slot="before"
				items={[
					{ name: "Home", href: "/" },
					{ name: "Case studies", href: "/case-studies/" },
					{ name: data.title, href: `/case-studies/${caseStudy.id}/` },
				]}
			/>
			<ChipList tags={data.tags} label="Competenze del case study" class="mt-6" />
			{data.metrics.length > 0 && (
				<MetricList label="Risultati misurati">
					{data.metrics.map((metric) => <MetricTile label={metric.label} value={metric.value} />)}
				</MetricList>
			)}
		</PageHeader>

		<PageContainer width="prose">
			<CaseStudySteps challenge={data.challenge} approach={data.approach} result={data.result} />

			<section class="mt-16 border-t border-line pt-10" aria-labelledby="documentation-title">
				<h2 id="documentation-title" class="text-[28px] leading-tight font-bold tracking-[-0.02em] text-text">Il case study completo</h2>
				{(data.liveUrl || data.githubUrl) && (
					<div class="mt-2 flex flex-wrap gap-x-6">
						{data.liveUrl && <ArrowLink label="Sito live" href={data.liveUrl} class="mt-0" />}
						{data.githubUrl && <ArrowLink label="Repository GitHub" href={data.githubUrl} class="mt-0" />}
					</div>
				)}
				<div class="prose-document mt-8">
					<Content />
				</div>
			</section>

			<ArrowLink label="Tutti i case study" href="/case-studies/" class="mt-12" />
		</PageContainer>
	</article>
</MainLayout>
