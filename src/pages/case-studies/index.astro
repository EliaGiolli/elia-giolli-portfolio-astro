---
import { getCollection } from "astro:content";
import MainLayout from "../../core/layouts/MainLayout.astro";
import CaseStudyListItem from "../../features/case-studies/CaseStudyListItem.astro";
import { publishedEntries } from "../../helpers";
import Breadcrumbs from "../../shared/components/Breadcrumbs.astro";
import PageContainer from "../../shared/components/PageContainer.astro";
import PageHeader from "../../shared/components/PageHeader.astro";
import EmptyState from "../../shared/ui/EmptyState.astro";
import ListCardList from "../../shared/ui/ListCardList.astro";

const caseStudies = publishedEntries(await getCollection("caseStudies"), import.meta.env.DEV);
---

<MainLayout
	title="Case studies SEO e Analytics"
	description="Case studies di Technical SEO e web analytics di Elia Giolli: audit, Core Web Vitals, dati strutturati e misurazione con GA4 e Search Console."
>
	<PageHeader
		kicker="Lavori documentati"
		title="Case study"
		dek="Dal problema alla misurazione: come analizzo un sito, quali interventi scelgo e come verifico che abbiano funzionato."
	>
		<Breadcrumbs slot="before" items={[{ name: "Home", href: "/" }, { name: "Case studies", href: "/case-studies/" }]} />
	</PageHeader>

	<PageContainer as="section" aria-label="Elenco dei case studies">
		<div class="max-w-3xl">
			{caseStudies.length > 0 ? (
				<ListCardList>
					{caseStudies.map((caseStudy) => <CaseStudyListItem caseStudy={caseStudy} headingLevel="h2" />)}
				</ListCardList>
			) : (
				<EmptyState message="Il primo case study è in lavorazione: lo pubblico appena ho i dati per raccontarlo." />
			)}
		</div>
	</PageContainer>
</MainLayout>
