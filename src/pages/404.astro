---
import MainLayout from "../core/layouts/MainLayout.astro";
import PageContainer from "../shared/components/PageContainer.astro";
import ArrowLink from "../shared/ui/ArrowLink.astro";

const suggestions = [
	{ label: "Torna alla home", href: "/" },
	{ label: "Vai al blog", href: "/blog/" },
	{ label: "Vai ai case study", href: "/case-studies/" },
];
---

<MainLayout title="Pagina non trovata" description="La pagina che cerchi non esiste o è stata spostata." noindex>
	<PageContainer as="section" class="py-20 lg:py-28" aria-labelledby="not-found-title">
		<p class="mb-4 font-mono text-meta text-accent uppercase">Errore 404</p>
		<h1 id="not-found-title" class="text-[34px] leading-[1.1] font-bold tracking-[-0.03em] text-text sm:text-[42px]">404 · Pagina non trovata</h1>
		<p class="mt-5 max-w-xl text-lead">La pagina che stai cercando non esiste o è stata spostata. Magari ti interessa il blog o i case study.</p>
		<ul class="mt-6 flex list-none flex-wrap gap-x-8 p-0">
			{suggestions.map((link) => <li><ArrowLink label={link.label} href={link.href} class="mt-0" /></li>)}
		</ul>
	</PageContainer>
</MainLayout>
