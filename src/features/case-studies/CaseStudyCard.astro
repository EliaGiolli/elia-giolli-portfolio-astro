---
import type { CollectionEntry } from "astro:content";
import Card from "../../shared/ui/Card.astro";
import TagList from "../../shared/ui/TagList.astro";

interface Props {
	caseStudy: CollectionEntry<"caseStudies">;
	headingLevel?: "h2" | "h3";
}

const { caseStudy, headingLevel = "h3" } = Astro.props;
const { id, data } = caseStudy;
const Heading = headingLevel;
---

<Card as="article" class="relative flex h-full flex-col bg-[#f6f4ee] p-6 transition-transform focus-within:ring-2 focus-within:ring-indigo-500 hover:-translate-y-0.5 lg:p-8" aria-labelledby={`case-study-${id}`}>
	<p class="text-sm font-bold uppercase tracking-[0.16em] text-indigo-600">Case study{data.draft && " · bozza"}</p>
	<Heading id={`case-study-${id}`} class="mt-2 text-2xl font-extrabold text-[#17252b]">
		{/* The pseudo-element makes the whole card clickable while keeping one link in the tab order. */}
		<a href={`/case-studies/${id}/`} class="after:absolute after:inset-0 focus-visible:outline-none">{data.title}</a>
	</Heading>
	<p class="mt-4 grow text-base leading-7 text-slate-600">{data.description}</p>
	<div class="mt-6">
		<TagList tags={data.tags} label={`Competenze usate in ${data.title}`} />
	</div>
	<p class="mt-6 border-t border-slate-200 pt-5 font-semibold text-indigo-600" aria-hidden="true">Leggi il case study →</p>
</Card>
