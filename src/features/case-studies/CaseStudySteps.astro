---
interface Props {
	challenge: string;
	approach: string;
	result: string;
}

const { challenge, approach, result } = Astro.props;

const steps = [
	{ label: "01 / Sfida", copy: challenge },
	{ label: "02 / Approccio", copy: approach },
	{ label: "03 / Risultato", copy: result },
];
---

<ol class="grid gap-6 lg:grid-cols-3">
	{steps.map((step) => (
		<li class="rounded-2xl border border-[#d9d6cb] bg-white p-6 shadow-[6px_6px_0_#ebe9e1]">
			<h2 class="font-mono text-sm font-bold uppercase text-[#a36a00]">{step.label}</h2>
			<p class="mt-4 text-base leading-7 text-slate-600">{step.copy}</p>
		</li>
	))}
</ol>
