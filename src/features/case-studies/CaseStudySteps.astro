---
import ListCard from "../../shared/ui/ListCard.astro";
import ListCardList from "../../shared/ui/ListCardList.astro";

interface Props {
	challenge: string;
	approach: string;
	result: string;
}

const { challenge, approach, result } = Astro.props;

const steps = [
	{ num: "01", label: "Sfida", copy: challenge },
	{ num: "02", label: "Approccio", copy: approach },
	{ num: "03", label: "Risultato", copy: result },
];
---

<ListCardList label="Il case study in tre passaggi">
	{steps.map((step) => (
		<ListCard meta={step.num} title={step.label} description={step.copy} headingLevel="h2" />
	))}
</ListCardList>
