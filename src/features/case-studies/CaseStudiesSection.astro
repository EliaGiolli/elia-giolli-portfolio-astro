---
import { getCollection } from "astro:content";
import { publishedEntries } from "../../helpers";
import ArrowLink from "../../shared/ui/ArrowLink.astro";
import EmptyState from "../../shared/ui/EmptyState.astro";
import ListCardList from "../../shared/ui/ListCardList.astro";
import HomeSection from "../home/HomeSection.astro";
import CaseStudyListItem from "./CaseStudyListItem.astro";

const caseStudies = publishedEntries(await getCollection("caseStudies"), import.meta.env.DEV);
---

<HomeSection id="case-studies" label="Case study">
	{caseStudies.length > 0 ? (
		<>
			<ListCardList>
				{caseStudies.map((caseStudy) => <CaseStudyListItem caseStudy={caseStudy} />)}
			</ListCardList>
			<ArrowLink label="Tutti i case study" href="/case-studies/" />
		</>
	) : (
		<EmptyState message="Il primo case study è in lavorazione: lo pubblico appena ho i dati per raccontarlo." />
	)}
</HomeSection>
