---
import { getCollection } from "astro:content";
import { publishedEntries } from "../../helpers";
import SectionHeading from "../../shared/components/SectionHeading.astro";
import CaseStudyCard from "./CaseStudyCard.astro";

const caseStudies = publishedEntries(await getCollection("caseStudies"), import.meta.env.DEV);
---

<section id="case-studies" class="border-b border-[#d9d6cb] bg-white" aria-labelledby="case-studies-title">
	<div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-24">
		<div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
			<SectionHeading
				id="case-studies-title"
				kicker="Lavori documentati"
				title="Case studies"
				intro="Audit, ottimizzazioni e misurazioni: ogni case study parte da un problema reale e arriva a un risultato verificabile."
			/>
			<a href="/case-studies/" class="font-bold text-indigo-600 underline-offset-4 hover:text-violet-600 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
				Tutti i case studies <span aria-hidden="true">→</span>
			</a>
		</div>

		<ul class="grid gap-6 md:grid-cols-2">
			{caseStudies.map((caseStudy) => (
				<li><CaseStudyCard caseStudy={caseStudy} /></li>
			))}
		</ul>
	</div>
</section>
