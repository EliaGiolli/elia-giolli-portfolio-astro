---
import { Image } from "astro:assets";
import Card from "../../shared/ui/Card.astro";
import type { Certificate } from "./certificates";

interface Props {
	certificate: Certificate;
	headingId: string;
}

const { certificate, headingId } = Astro.props;
---

<Card as="article" class="grid overflow-hidden lg:grid-cols-[0.9fr_1.1fr]" aria-labelledby={headingId}>
	<div class="flex min-h-64 items-center justify-center bg-[#17252b] p-6 sm:p-10">
		<Image src={certificate.image} alt={certificate.imageAlt} widths={[400, 720]} sizes="(min-width: 1024px) 480px, 100vw" class="max-h-72 w-full rounded-lg object-contain" loading="lazy" />
	</div>
	<div class="flex flex-col justify-center p-6 sm:p-10">
		<p class="text-sm font-bold uppercase tracking-[0.16em] text-indigo-600">{certificate.status}</p>
		<h3 id={headingId} class="mt-3 text-2xl font-extrabold text-[#17252b] sm:text-3xl">{certificate.title}</h3>
		<p class="mt-3 font-semibold text-slate-700">{certificate.issuer}</p>
		<p class="mt-6 text-base leading-7 text-slate-600">{certificate.copy}</p>
		{certificate.verifyUrl && (
			<a href={certificate.verifyUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex font-bold text-indigo-600 underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
				Verifica il certificato <span class="ml-2" aria-hidden="true">↗</span>
			</a>
		)}
	</div>
</Card>
