---
import { getImage } from "astro:assets";
import ListCard from "../../shared/ui/ListCard.astro";
import ListCardList from "../../shared/ui/ListCardList.astro";
import HomeSection from "../home/HomeSection.astro";
import { certificates } from "./certificates";

// The title opens the official verification page when there is one, otherwise the optimized
// image of the certificate: either way the claim comes with its proof.
const entries = await Promise.all(
	certificates.map(async (certificate) => ({
		certificate,
		href: certificate.verifyUrl ?? (await getImage({ src: certificate.image, width: 1200, format: "webp" })).src,
	})),
);
---

<HomeSection id="certificates" label="Certificati">
	<ListCardList>
		{entries.map(({ certificate, href }) => (
			<ListCard meta={certificate.provider} title={certificate.title} href={href} description={certificate.copy} tags={[certificate.status]}>
				<p class="mt-2 text-small text-text-muted">{certificate.issuer}</p>
			</ListCard>
		))}
	</ListCardList>
</HomeSection>
