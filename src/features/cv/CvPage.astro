---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Card from "../../shared/ui/Card.astro";
import { SITE_TAGLINE } from "../../shared/utils/constants";
import profilePhoto from "../home/assets/foto-elia.jpg";

const technicalSkills = [
	["SEO tecnica", "Core Web Vitals · HTML semantico · dati strutturati Schema.org · sitemap, robots.txt e canonical"],
	["Web analytics", "Google Analytics 4 · Google Search Console · Consent Mode v2"],
	["Digital marketing", "Inbound marketing · SEO on-page e contenuti · HubSpot"],
	["Sviluppo front-end", "HTML · CSS · JavaScript · Astro · Tailwind CSS · Alpine.js"],
	["Ticketing e collaborazione", "ServiceNow · Microsoft 365 / Office 365 · Microsoft Teams"],
	["Sistemi e reti", "TCP/IP · DNS · Windows e Linux · Active Directory"],
	["Scripting e dati", "Python · PowerShell · Bash · SQL (MySQL, PostgreSQL)"],
];

const caseStudies = (await getCollection("caseStudies")).filter((entry) => !entry.data.draft);
---

<main id="main-content" tabindex="-1" class="bg-[#f6f4ee] text-[#17252b] focus:outline-none" aria-labelledby="cv-title">
	<header class="border-b border-[#31454c] bg-[#17252b] text-white">
		<div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 lg:grid-cols-[auto_1fr] lg:items-center lg:px-8 lg:py-20">
			<div class="flex items-center gap-5">
				<a href="/" aria-label="Torna alla home" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/20 text-xl text-[#f2b84b] transition-colors hover:border-[#f2b84b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f2b84b]">←</a>
				<Image src={profilePhoto} alt="Elia Giolli" width={160} height={160} class="h-28 w-28 rounded-2xl border-2 border-[#f2b84b] object-cover sm:h-36 sm:w-36" />
			</div>
			<div>
				<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-[#f2b84b]">Curriculum vitae</p>
				<h1 id="cv-title" class="text-4xl font-extrabold tracking-tight sm:text-6xl">Elia Giolli</h1>
				<p class="mt-3 text-xl font-medium text-slate-200">{SITE_TAGLINE}</p>
				<p class="mt-5 max-w-3xl text-sm leading-6 text-slate-300">Peccioli (PI) · Patente B, automunito · Disponibile al trasferimento e agli spostamenti in Italia e in Europa</p>
				<nav class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Contatti CV">
					<a href="tel:+393405335525" class="text-[#f2b84b] underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f2b84b]">+39 340 5335525</a>
					<a href="mailto:eliagiolli22@gmail.com" class="text-[#f2b84b] underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f2b84b]">eliagiolli22@gmail.com</a>
					<a href="https://www.linkedin.com/in/eliagiolli/" target="_blank" rel="noreferrer" class="text-[#f2b84b] underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f2b84b]">LinkedIn</a>
					<a href="https://github.com/EliaGiolli" target="_blank" rel="noreferrer" class="text-[#f2b84b] underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f2b84b]">GitHub</a>
				</nav>
			</div>
		</div>
	</header>

	<div class="mx-auto grid max-w-6xl gap-16 px-6 py-14 lg:grid-cols-[1.25fr_0.75fr] lg:px-8 lg:py-20">
		<div class="space-y-16">
			<section aria-labelledby="profile-title">
				<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-indigo-600">Profilo</p>
				<h2 id="profile-title" class="text-3xl font-extrabold tracking-tight">Dal codice alla SERP</h2>
				<p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">Front-end developer con esperienza di supporto IT in ambiente enterprise, oggi in transizione verso la SEO tecnica e la web analytics. Certificato HubSpot Digital Marketing, unisco la conoscenza di HTML, performance e architettura web all'analisi dei dati con Google Analytics 4 e Search Console. Laureato in Lingue, parlo cinque lingue straniere: un vantaggio per la SEO internazionale e per contenuti chiari.</p>
			</section>

			<section aria-labelledby="experience-title">
				<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-indigo-600">Esperienza professionale</p>
				<h2 id="experience-title" class="text-3xl font-extrabold tracking-tight">Esperienza</h2>
				<div class="mt-8 space-y-8">
					<article class="border-l-2 border-[#f2b84b] pl-5">
						<h3 class="text-xl font-extrabold">IT Help Desk Technician</h3>
						<p class="mt-1 font-semibold text-slate-700">Var Group S.p.A., Empoli (FI) · 12/2025 · contratto a termine</p>
						<p class="mt-3 leading-7 text-slate-600">Supporto remoto per la rete logistica automotive Volkswagen/MAN, con assistenza a magazzini, concessionari e utenti finali.</p>
						<ul class="mt-3 list-disc space-y-2 pl-5 leading-7 text-slate-600">
							<li>Supporto di primo livello e gestione del ciclo di vita dei ticket su ServiceNow.</li>
							<li>Collaborazione quotidiana tramite Microsoft Teams e Microsoft 365 / Office 365.</li>
							<li>Troubleshooting di Cross, ElsaPro e PetrA, documentazione ed escalation al secondo livello.</li>
						</ul>
					</article>
					<article class="border-l-2 border-[#f2b84b] pl-5">
						<h3 class="text-xl font-extrabold">Operatore di scalo / Addetto Lost & Found</h3>
						<p class="mt-1 font-semibold text-slate-700">Consulta S.p.A. (gruppo Aviapartner), Aeroporto di Pisa · 04/2024–08/2024 e 08/2022–11/2022</p>
						<ul class="mt-3 list-disc space-y-2 pl-5 leading-7 text-slate-600">
							<li>Assistenza agli utenti e risoluzione dei problemi in tempo reale in un ambiente time-critical.</li>
							<li>Gestione degli incidenti on-site, prioritizzazione e coordinamento con team interni e compagnie aeree.</li>
						</ul>
					</article>
				</div>
				<p class="mt-6 text-sm leading-6 text-slate-500">Altre esperienze: receptionist in agriturismo · promoter Iliad · consulente commerciale.</p>
			</section>

			<section aria-labelledby="projects-title">
				<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-indigo-600">Lavori documentati</p>
				<h2 id="projects-title" class="text-3xl font-extrabold tracking-tight">Case studies</h2>
				<div class="mt-8 grid gap-5">
					{caseStudies.map((caseStudy) => (
						<Card as="article" class="p-6">
							<h3 class="text-xl font-extrabold">{caseStudy.data.title}</h3>
							<p class="mt-3 leading-7 text-slate-600">{caseStudy.data.description}</p>
							<a href={`/case-studies/${caseStudy.id}/`} class="mt-5 inline-flex font-bold text-indigo-600 underline-offset-4 hover:text-violet-600 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">Apri il case study <span class="ml-2" aria-hidden="true">→</span></a>
						</Card>
					))}
				</div>
			</section>
		</div>

		<aside class="space-y-8" aria-label="Competenze e formazione">
			<section aria-labelledby="skills-title">
				<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-indigo-600">Competenze tecniche</p>
				<h2 id="skills-title" class="text-2xl font-extrabold">Strumenti e aree di competenza</h2>
				<div class="mt-6 space-y-5">
					{technicalSkills.map(([label, skills]) => (
						<div class="border-t border-[#d9d6cb] pt-4">
							<h3 class="font-extrabold">{label}</h3>
							<p class="mt-1 text-sm leading-6 text-slate-600">{skills}</p>
						</div>
					))}
				</div>
			</section>

			<section aria-labelledby="education-title">
				<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-indigo-600">Formazione</p>
				<h2 id="education-title" class="text-2xl font-extrabold">Certificazioni e istruzione</h2>
				<ul class="mt-6 space-y-5 text-sm leading-6 text-slate-600">
					<li><strong class="text-[#17252b]">Digital Marketing Certified</strong><br />HubSpot Academy · settembre 2026, valida fino a ottobre 2028</li>
					<li><strong class="text-[#17252b]">Active Directory & Group Policy Lab</strong><br />Udemy, 7 ore · completato agosto 2026</li>
					<li><strong class="text-[#17252b]">Cisco Networking Academy</strong><br />Networking Basics · Network Devices and Initial Configuration · Network Support and Security · Introduction to Cybersecurity</li>
					<li><strong class="text-[#17252b]">Tecnico di reti IT</strong><br />Talentform, patrocinato da Forma.Temp</li>
					<li><strong class="text-[#17252b]">Laurea in Lingue e Letterature Straniere</strong><br />Università di Pisa · 2019</li>
					<li><strong class="text-[#17252b]">Diploma di Perito in Informatica e Telecomunicazioni</strong><br />ITIS G. Marconi · 2014</li>
				</ul>
			</section>

			<section aria-labelledby="languages-title">
				<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-indigo-600">Lingue</p>
				<h2 id="languages-title" class="text-2xl font-extrabold">Comunicazione internazionale</h2>
				<p class="mt-4 leading-7 text-slate-600">Italiano madrelingua · Inglese C1 · Russo C1 · Spagnolo B2 · Tedesco B1 · Polacco B1</p>
			</section>
		</aside>
	</div>
</main>

<style>
	@media print {
		:global(header),
		:global(footer) {
			display: none;
		}

		main {
			background: white;
		}
	}
</style>
