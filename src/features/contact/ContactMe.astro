---
import Form from "../../shared/forms/Form.astro";
import Input from "../../shared/forms/Input.astro";
import Textarea from "../../shared/forms/Textarea.astro";
import ArrowLink from "../../shared/ui/ArrowLink.astro";
import { CONTACT_EMAIL } from "../../shared/utils/constants";
import HomeSection from "../home/HomeSection.astro";

const emailJs = {
	serviceId: import.meta.env.PUBLIC_EMAILJS_SERVICE_ID ?? "",
	templateId: import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID ?? "",
	publicKey: import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY ?? "",
};
---

<HomeSection id="contact" label="Contatti">
	<div class="text-lead">
		<p>
			Cerco opportunità come <strong class="font-medium text-text">SEO specialist junior</strong>, <strong class="font-medium text-text">Technical SEO</strong> e <strong class="font-medium text-text">web analyst</strong>, in Italia o in contesti internazionali. Scrivimi anche solo per confrontarci.
		</p>
		<ArrowLink label={CONTACT_EMAIL} href={`mailto:${CONTACT_EMAIL}`} />
	</div>

	<Form id="contact-form" serviceId={emailJs.serviceId} templateId={emailJs.templateId} publicKey={emailJs.publicKey} class="mt-8 grid gap-5">
		<div class="grid gap-5 sm:grid-cols-2">
			<Input name="from_name" label="Nome" placeholder="Il tuo nome" autocomplete="name" required />
			<Input name="reply_to" label="Email" type="email" placeholder="nome@azienda.it" autocomplete="email" required />
		</div>
		<Input name="subject" label="Oggetto" placeholder="Opportunità di lavoro, audit SEO, collaborazione..." required />
		<Textarea name="message" label="Messaggio" placeholder="Descrivi brevemente il contesto..." required />
		<div class="flex flex-wrap items-center gap-4">
			<button
				type="submit"
				class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-pill bg-accent px-6 font-semibold text-bg transition-colors duration-200 hover:bg-text disabled:cursor-wait disabled:opacity-70"
			>
				<span data-submit-label>Invia messaggio</span>
				<span aria-hidden="true">→</span>
			</button>
			<p id="contact-status" class="text-small text-text-muted" role="status" aria-live="polite"></p>
		</div>
	</Form>
</HomeSection>

<script>
	import emailjs from "@emailjs/browser";

	const forms = document.querySelectorAll<HTMLFormElement>("[data-contact-form]");

	forms.forEach((form) => {
		form.addEventListener("submit", async (event) => {
			const serviceId = form.dataset.serviceId;
			const templateId = form.dataset.templateId;
			const publicKey = form.dataset.publicKey;
			const status = document.querySelector<HTMLElement>("#contact-status");
			const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
			const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

			if (!serviceId || !templateId || !publicKey) {
				if (status) status.textContent = "Si aprirà il tuo client email per completare l'invio.";
				return;
			}

			event.preventDefault();
			// With EmailJS on, native validation is off (novalidate): check the fields before sending.
			if (!form.reportValidity()) return;

			if (status) status.textContent = "Invio in corso...";
			if (submitLabel) submitLabel.textContent = "Invio...";
			if (submitButton) submitButton.disabled = true;

			try {
				await emailjs.sendForm(serviceId, templateId, form, { publicKey });
				form.reset();
				if (status) status.textContent = "Messaggio inviato. Grazie, ti risponderò presto.";
			} catch {
				if (status) status.textContent = "Invio non riuscito. Puoi scrivermi direttamente via email.";
			} finally {
				if (submitLabel) submitLabel.textContent = "Invia messaggio";
				if (submitButton) submitButton.disabled = false;
			}
		});
	});
</script>
