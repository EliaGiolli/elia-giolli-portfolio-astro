---
import { Image } from "astro:assets";
import SectionHeading from "../../shared/components/SectionHeading.astro";
import graduationPhoto from "./assets/foto-laurea.jpg";

const story = [
	{
		icon: "◈",
		title: "Da chi costruisce a chi fa trovare",
		paragraphs: [
			"Vengo dallo sviluppo front-end e dal supporto IT: so come nasce una pagina, come viene servita e perché a volte si rompe. Oggi metto questa esperienza al servizio della SEO tecnica e dell'analytics.",
			"Mi interessa la parte misurabile del digital marketing: indicizzazione, Core Web Vitals, dati strutturati, Google Analytics 4 e Search Console. Meno social, più dati.",
		],
	},
	{
		icon: "⌁",
		title: "Metodo, dati e lingue",
		paragraphs: [
			"Dal debug ho imparato un metodo che applico alla SEO: osservo il sintomo, raccolgo evidenze, cambio una variabile alla volta e verifico il risultato con i numeri.",
			"Sono laureato in Lingue e parlo cinque lingue straniere, con inglese e russo a livello C1: un vantaggio concreto per la SEO internazionale e per scrivere contenuti chiari.",
		],
	},
];
---

<section
	id="about"
	class="border-b border-[#d9d6cb] bg-[#f6f4ee]"
	aria-labelledby="about-title"
>
	<div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-24">
		<div class="mb-12">
			<SectionHeading
				id="about-title"
				kicker="Profilo"
				title="Su di me"
				intro="Un percorso non lineare: lingue, codice, supporto tecnico e ora SEO. Ogni tappa aggiunge un pezzo."
			/>
		</div>

		<div class="grid gap-10 lg:grid-cols-[0.8fr_1fr_1fr] lg:gap-12">
			<figure>
				<div class="overflow-hidden rounded-2xl border border-[#d9d6cb] bg-[#ebe9e1] shadow-[12px_12px_0_#d9d6cb]">
					<Image
						src={graduationPhoto}
						alt="Elia Giolli durante la cerimonia di laurea"
						class="aspect-4/5 h-full w-full object-cover"
						width={720}
						height={900}
						loading="lazy"
					/>
				</div>
				<figcaption class="mt-3 text-sm text-slate-600">Una formazione linguistica al servizio di contenuti chiari e SEO internazionale.</figcaption>
			</figure>

			{story.map((block) => (
				<article class="border-t-2 border-[#17252b] pt-5">
					<div class="mb-5 flex items-center gap-3">
						<span class="text-2xl text-[#d89418]" aria-hidden="true">{block.icon}</span>
						<h3 class="text-xl font-bold text-[#17252b]">{block.title}</h3>
					</div>
					<div class="space-y-5 text-base leading-7 text-slate-600">
						{block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
					</div>
				</article>
			))}
		</div>
	</div>
</section>
