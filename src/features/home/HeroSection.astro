---
import Button from "../../shared/ui/Button.astro";

const skillGroups = [
	{
		label: "Technical SEO",
		items: "Core Web Vitals · HTML semantico · Schema.org · Sitemap e robots.txt",
	},
	{
		label: "Web analytics",
		items: "Google Analytics 4 · Google Search Console · Consent Mode",
	},
	{
		label: "Digital marketing",
		items: "Inbound marketing · SEO on-page · HubSpot Academy",
	},
	{
		label: "Sviluppo front-end",
		items: "HTML · CSS · JavaScript · Astro · Tailwind CSS",
	},
];
---

<section
	id="hero"
	class="relative overflow-hidden border-b border-[#31454c] bg-[#17252b] text-white"
	aria-labelledby="hero-title"
>
	<div class="mx-auto grid max-w-6xl gap-14 px-6 py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-8 lg:py-32">
		<div class="max-w-3xl">
			<p class="mb-6 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.18em] text-[#f2b84b]">
				<span class="h-px w-8 bg-[#f2b84b]" aria-hidden="true"></span>
				Elia Giolli
			</p>
			<h1 id="hero-title" class="max-w-3xl text-4xl font-extrabold tracking-tight text-balance text-white sm:text-6xl">
				Front-end developer <span class="text-[#f2b84b]">turned</span> Technical SEO &amp; Analytics specialist
			</h1>
			<p class="mt-6 max-w-2xl text-xl font-medium leading-8 text-slate-200">
				Ho passato anni a costruire siti. Ora aiuto i siti a farsi trovare e a capire cosa succede quando qualcuno arriva.
			</p>
			<p class="mt-5 max-w-2xl text-base leading-7 text-slate-300">
				Unisco la conoscenza del codice a SEO tecnica e analytics: performance, struttura, dati e misurazione, con lo stesso metodo che usavo per il debug.
			</p>

			<div class="mt-8 flex flex-wrap gap-4">
				<Button href="/#case-studies" variant="primary" size="lg" class="hero-primary">
					<span>Guarda i case studies</span>
					<span aria-hidden="true">→</span>
				</Button>
				<Button href="/blog/" variant="secondary" size="lg" class="hero-secondary">
					<span>Leggi il blog</span>
				</Button>
				<Button href="/cv/" variant="secondary" size="lg" class="hero-secondary">
					<span>Curriculum</span>
				</Button>
			</div>
		</div>

		<aside class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8" aria-labelledby="skills-title">
			<h2 id="skills-title" class="text-2xl font-bold text-white">Competenze</h2>
			<p class="mt-3 mb-6 text-sm leading-6 text-slate-300">
				Dal codice alla SERP: gli strumenti con cui analizzo, ottimizzo e misuro un sito.
			</p>
			<ul class="grid gap-4">
				{skillGroups.map((group, index) => (
					<li class="flex gap-3 border-t border-white/10 pt-4">
						<span class="mt-0.5 font-mono text-sm text-[#f2b84b]" aria-hidden="true">0{index + 1}</span>
						<div>
							<h3 class="font-semibold text-white">{group.label}</h3>
							<p class="mt-1 text-sm text-slate-300">{group.items}</p>
						</div>
					</li>
				))}
			</ul>
		</aside>
	</div>
</section>
