---
import type { CollectionEntry } from "astro:content";
import { readingTime } from "../../helpers";
import Card from "../../shared/ui/Card.astro";
import PostMeta from "./PostMeta.astro";

interface Props {
	post: CollectionEntry<"blog">;
	headingLevel?: "h2" | "h3";
}

const { post, headingLevel = "h2" } = Astro.props;
const { id, data } = post;
const Heading = headingLevel;
---

<Card as="article" class="relative flex h-full flex-col p-6 transition-transform focus-within:ring-2 focus-within:ring-indigo-500 hover:-translate-y-0.5 lg:p-8" aria-labelledby={`post-${id}`}>
	<p class="text-sm font-bold uppercase tracking-[0.16em] text-indigo-600">{data.tags[0] ?? "Articolo"}{data.draft && " · bozza"}</p>
	<Heading id={`post-${id}`} class="mt-2 text-2xl font-extrabold text-[#17252b] text-balance">
		<a href={`/blog/${id}/`} class="after:absolute after:inset-0 focus-visible:outline-none">{data.title}</a>
	</Heading>
	<p class="mt-4 grow text-base leading-7 text-slate-600">{data.description}</p>
	<PostMeta pubDate={data.pubDate} minutes={readingTime(post.body ?? "")} class="mt-6 border-t border-slate-200 pt-5 text-slate-500" />
</Card>
