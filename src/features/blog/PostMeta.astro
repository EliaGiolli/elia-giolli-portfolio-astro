---
import { formatDate, toIsoDate } from "../../helpers";

interface Props {
	pubDate: Date;
	updatedDate?: Date;
	minutes: number;
	class?: string;
}

const { pubDate, updatedDate, minutes, class: extraClass } = Astro.props;
---

<p class:list={["flex flex-wrap gap-x-2 gap-y-1 text-small text-text-muted", extraClass]}>
	<time datetime={toIsoDate(pubDate)}>{formatDate(pubDate)}</time>
	{updatedDate && <span><span aria-hidden="true">· </span>Aggiornato il <time datetime={toIsoDate(updatedDate)}>{formatDate(updatedDate)}</time></span>}
	{minutes > 0 && <span><span aria-hidden="true">· </span>{minutes} min di lettura</span>}
</p>
