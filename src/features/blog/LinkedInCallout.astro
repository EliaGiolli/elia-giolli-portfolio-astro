---
import { NEW_TAB_HINT, LINKEDIN_URL } from "../../shared/utils/constants";

interface Props {
	linkedinUrl?: string;
}

const { linkedinUrl } = Astro.props;
---

<aside class="rounded-card bg-surface p-6 shadow-card sm:p-8 print:shadow-none" aria-labelledby="linkedin-callout-title">
	<h2 id="linkedin-callout-title" class="text-card-title text-text">Continuiamo la conversazione su LinkedIn</h2>
	<p class="mt-2 text-card-body">
		{linkedinUrl
			? "Ho condiviso una versione breve di questo articolo su LinkedIn: lì trovi la discussione e i commenti."
			: "Pubblico su LinkedIn riflessioni brevi su SEO tecnica e analytics. Seguimi per non perdere i prossimi articoli."}
	</p>
	<a
		href={linkedinUrl ?? LINKEDIN_URL}
		target="_blank"
		rel="noopener noreferrer"
		class="mt-4 inline-flex min-h-11 items-center gap-2 font-semibold text-text transition-colors duration-200 hover:text-accent"
	>
		{linkedinUrl ? "Leggi il post su LinkedIn" : "Seguimi su LinkedIn"}
		<span aria-hidden="true">↗</span>
		<span class="sr-only">{NEW_TAB_HINT}</span>
	</a>
</aside>
