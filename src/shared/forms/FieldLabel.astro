---
interface Props {
	for: string;
	label: string;
	required?: boolean;
}

const { for: fieldId, label, required = false } = Astro.props;
---

<label for={fieldId} class="text-small font-semibold text-text">
	{label}{required && <span class="ml-1 text-accent" aria-hidden="true">*</span>}
	{required && <span class="sr-only"> obbligatorio</span>}
</label>
