---
import FieldLabel from "./FieldLabel.astro";
import { fieldClass } from "./fieldStyles";

interface Props {
	name: string;
	label: string;
	type?: "text" | "email" | "tel" | "url";
	placeholder?: string;
	required?: boolean;
	autocomplete?: string;
	class?: string;
}

const { name, label, type = "text", placeholder, required = false, autocomplete, class: extraClass } = Astro.props;
const inputId = `contact-${name}`;
---

<div class:list={["grid gap-2", extraClass]}>
	<FieldLabel for={inputId} label={label} required={required} />
	<input
		id={inputId}
		name={name}
		type={type}
		placeholder={placeholder}
		required={required}
		autocomplete={autocomplete}
		class:list={[fieldClass, "min-h-11"]}
	/>
</div>
