---
import Chip from "./Chip.astro";

interface Props {
	tags: readonly string[];
	label?: string;
	class?: string;
}

const { tags, label = "Tag", class: extraClass } = Astro.props;
const visibleTags = tags.map((tag) => tag.trim()).filter(Boolean);
---

{visibleTags.length > 0 && (
	<ul class:list={["mt-4 flex list-none flex-wrap gap-2 p-0", extraClass]} aria-label={label}>
		{visibleTags.map((tag) => <Chip label={tag} />)}
	</ul>
)}
