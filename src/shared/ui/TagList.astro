---
interface Props {
	tags: string[];
	label: string;
	tone?: "light" | "dark";
}

const { tags, label, tone = "light" } = Astro.props;
---

<ul class="flex flex-wrap gap-2" aria-label={label}>
	{tags.map((tag) => (
		<li
			class:list={[
				"rounded-md border px-3 py-1 text-sm font-medium",
				tone === "dark" ? "border-white/20 text-slate-200" : "border-[#d9d6cb] bg-white text-slate-700",
			]}
		>
			{tag}
		</li>
	))}
</ul>
