---
import Logo from "./Logo.astro";

// The logo and the name, linking home. Shared by the navbar and the CV header.
interface Props {
	label?: string;
}

const { label = "Elia Giolli, homepage" } = Astro.props;
---

<a href="/" aria-label={label} class="group inline-flex min-h-11 items-center gap-3 text-text">
	<span class="inline-flex size-10 items-center justify-center rounded-logo bg-surface shadow-logo">
		<Logo size={24} />
	</span>
	<span class="font-semibold tracking-[-0.01em] transition-colors duration-200 group-hover:text-accent" aria-hidden="true">Elia Giolli</span>
</a>
