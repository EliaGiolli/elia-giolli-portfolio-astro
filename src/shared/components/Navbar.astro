---
import Button from "../ui/Button.astro";
import NavLink from "./NavLink.astro";

import { CONTACT_LINK, LOGO_ALT_TEXT, NAV_LINKS } from "../utils/constants";
---

<header
  class="sticky top-0 z-50 border-b border-indigo-200/80 bg-slate-50/85 shadow-[0_10px_30px_rgba(79,70,229,0.08)] backdrop-blur-md"
  x-data="{ open: false }"
  @keydown.escape.window="open = false"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex min-h-19 items-center justify-between gap-4">
      <a
        class="flex items-center gap-3 rounded-full px-2 py-1.5 text-indigo-600 no-underline transition-transform duration-200 hover:scale-[1.01] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50"
        href="/"
        aria-label="Elia Giolli, homepage"
      >
        <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full border border-indigo-200 bg-white shadow-sm shadow-indigo-100">
          <img src="/logo.svg" width="44" height="44" alt={LOGO_ALT_TEXT} class="h-full w-full object-contain" />
        </div>
        <div class="hidden sm:block">
          <div class="text-sm font-medium uppercase tracking-[0.2em] text-slate-500">Developer → SEO</div>
          <div class="text-base font-bold text-indigo-700">Elia Giolli</div>
        </div>
      </a>

      <nav class="hidden md:block" aria-label="Navigazione principale">
        <ul class="flex list-none items-center gap-2 p-0">
          {NAV_LINKS.map((link) => (
            <li><NavLink href={link.href}>{link.label}</NavLink></li>
          ))}
          <li><NavLink href={CONTACT_LINK.href} variant="cta">{CONTACT_LINK.label}</NavLink></li>
        </ul>
      </nav>

      <div class="md:hidden">
        <Button
          variant="ghost"
          size="sm"
          class="h-11 w-11 rounded-xl border border-indigo-200 bg-white p-0 text-indigo-700 shadow-sm shadow-indigo-100 transition-colors hover:bg-indigo-50"
          aria-label="Apri il menu di navigazione"
          :aria-expanded="open.toString()"
          aria-controls="mobile-navigation"
          x-on:click="open = !open"
        >
          <span class="flex flex-col gap-1.5" aria-hidden="true">
            <span class="block h-0.5 w-5 rounded-full bg-current transition-transform duration-200" :class="open ? 'translate-y-2 rotate-45' : ''"></span>
            <span class="block h-0.5 w-5 rounded-full bg-current transition-opacity duration-200" :class="open ? 'opacity-0' : ''"></span>
            <span class="block h-0.5 w-5 rounded-full bg-current transition-transform duration-200" :class="open ? '-translate-y-2 -rotate-45' : ''"></span>
          </span>
        </Button>
      </div>
    </div>

    <nav
      id="mobile-navigation"
      class="border-t border-indigo-100 py-4 md:hidden"
      x-cloak
      x-show="open"
      x-transition.origin.top.duration.200ms
      @click.outside="open = false"
      aria-label="Navigazione mobile"
    >
      <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
        {NAV_LINKS.map((link) => (
          <li><NavLink href={link.href} variant="mobile" @click="open = false">{link.label}</NavLink></li>
        ))}
        <li><NavLink href={CONTACT_LINK.href} variant="mobile-cta" @click="open = false">{CONTACT_LINK.label}</NavLink></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import "../lib/alpine";
</script>
