---
import { buildBreadcrumbSchema } from "../../helpers";
import JsonLd from "./JsonLd.astro";

interface Crumb {
	name: string;
	href: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const schema = buildBreadcrumbSchema(items.map((item) => ({ name: item.name, url: new URL(item.href, siteUrl).href })));
---

<nav aria-label="Percorso" class="text-sm text-slate-300">
	<ol class="flex flex-wrap items-center gap-2">
		{items.map((item, index) => {
			const isLast = index === items.length - 1;
			return (
				<li class="flex items-center gap-2">
					{isLast ? (
						<span aria-current="page" class="text-white">{item.name}</span>
					) : (
						<>
							<a href={item.href} class="font-bold text-[#f2b84b] underline-offset-4 hover:text-[#ffd477] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f2b84b]">{item.name}</a>
							<span aria-hidden="true">›</span>
						</>
					)}
				</li>
			);
		})}
	</ol>
</nav>
<JsonLd schema={schema} />
