---
import { buildBreadcrumbSchema } from "../../helpers";
import JsonLd from "./JsonLd.astro";

interface Crumb {
	name: string;
	href: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const schema = buildBreadcrumbSchema(items.map((item) => ({ name: item.name, url: new URL(item.href, siteUrl).href })));
---

<nav aria-label="Percorso" class="text-small text-text-muted">
	<ol class="flex list-none flex-wrap items-center gap-x-2 p-0">
		{items.map((item, index) => {
			const isLast = index === items.length - 1;
			return (
				<li class="flex min-w-0 items-center gap-2">
					{isLast ? (
						<span aria-current="page" class="line-clamp-1 text-text-body">{item.name}</span>
					) : (
						<>
							<a href={item.href} class="inline-flex min-h-11 items-center font-medium text-text transition-colors duration-200 hover:text-accent">{item.name}</a>
							<span aria-hidden="true">/</span>
						</>
					)}
				</li>
			);
		})}
	</ol>
</nav>
<JsonLd schema={schema} />
