---
import { isCurrentPath } from "../../helpers";
import { cn } from "../lib/cn";

interface Props {
	href: string;
	variant?: "desktop" | "cta" | "mobile" | "mobile-cta";
	[key: string]: unknown;
}

const { href, variant = "desktop", ...attributes } = Astro.props;

const variants = {
	desktop: "rounded-full px-3.5 py-2 text-sm font-semibold text-slate-700 hover:bg-indigo-100 hover:text-indigo-700",
	cta: "rounded-full bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-indigo-200 hover:bg-indigo-700",
	mobile: "block rounded-2xl px-4 py-3 font-semibold text-slate-800 hover:bg-indigo-100 hover:text-indigo-700",
	"mobile-cta": "mt-1 block rounded-2xl bg-indigo-600 px-4 py-3 font-semibold text-white shadow-sm shadow-indigo-200 hover:bg-indigo-700",
};

const isCurrent = isCurrentPath(href, Astro.url.pathname);
---

<a
	href={href}
	aria-current={isCurrent ? "page" : undefined}
	class={cn(
		"no-underline transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500",
		variants[variant],
		isCurrent && variant === "desktop" && "bg-indigo-100 text-indigo-700",
	)}
	{...attributes}
>
	<slot />
</a>
