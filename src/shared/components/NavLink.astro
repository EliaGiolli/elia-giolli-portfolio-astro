---
import { isCurrentPath } from "../../helpers";
import { cn } from "../lib/cn";

interface Props {
	href: string;
	variant?: "desktop" | "cta" | "mobile" | "mobile-cta";
	[key: string]: unknown;
}

const { href, variant = "desktop", ...attributes } = Astro.props;

const variants = {
	desktop: "inline-flex min-h-11 items-center px-3 text-small font-medium text-text-body hover:text-text aria-[current=page]:text-text",
	cta: "ml-2 inline-flex min-h-11 items-center rounded-pill border border-toc-line px-5 text-small font-semibold text-text hover:border-accent hover:text-accent",
	mobile: "flex min-h-11 items-center rounded-tile px-4 font-medium text-text-body hover:bg-surface hover:text-text aria-[current=page]:text-text",
	"mobile-cta": "mt-2 flex min-h-11 items-center rounded-pill border border-toc-line px-4 font-semibold text-text hover:border-accent hover:text-accent",
};

const isCurrent = isCurrentPath(href, Astro.url.pathname);
---

<a
	href={href}
	aria-current={isCurrent ? "page" : undefined}
	class={cn("transition-colors duration-200", variants[variant])}
	{...attributes}
>
	<slot />
	{isCurrent && (variant === "desktop" || variant === "mobile") && <span class="ml-2 inline-block h-px w-4 bg-accent" aria-hidden="true"></span>}
</a>
