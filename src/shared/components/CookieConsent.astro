---
import { ANALYTICS_ID as measurementId } from "../utils/analytics";
---

{measurementId && (
	<div
		x-data={`cookieConsent(${JSON.stringify(measurementId)})`}
		x-show="visible"
		x-cloak
		x-transition.opacity.duration.200ms
		role="dialog"
		aria-modal="false"
		aria-labelledby="cookie-consent-title"
		aria-describedby="cookie-consent-text"
		class="fixed inset-x-4 bottom-4 z-60 print:hidden mx-auto max-w-2xl rounded-card bg-surface p-5 text-text-body shadow-card ring-1 ring-line sm:p-6"
	>
		<h2 id="cookie-consent-title" class="text-card-title text-text">Statistiche anonime, solo se vuoi</h2>
		<p id="cookie-consent-text" class="mt-2 text-small">
			Uso Google Analytics 4 per capire quali contenuti sono utili. Nessun cookie viene installato finché non accetti.{" "}
			<a href="/privacy" class="font-semibold text-accent underline underline-offset-4 hover:text-text">Privacy e cookie</a>
		</p>
		{/* Same weight for both choices: refusing must be as easy as accepting. */}
		<div class="mt-4 flex flex-wrap gap-3">
			<button
				type="button"
				x-on:click="choose('granted')"
				class="min-h-11 cursor-pointer rounded-pill border border-toc-line px-5 text-small font-semibold text-text transition-colors duration-200 hover:border-accent hover:text-accent"
			>
				Accetta
			</button>
			<button
				type="button"
				x-on:click="choose('denied')"
				class="min-h-11 cursor-pointer rounded-pill border border-toc-line px-5 text-small font-semibold text-text transition-colors duration-200 hover:border-accent hover:text-accent"
			>
				Rifiuta
			</button>
		</div>
	</div>
)}

<script>
	import "../lib/alpine";
</script>
