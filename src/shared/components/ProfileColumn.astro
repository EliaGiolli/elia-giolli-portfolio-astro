---
import type { IndexItem } from "../../helpers/indexNav";
import IndexNav from "./IndexNav.astro";
import Logo from "./Logo.astro";
import SocialLinks from "./SocialLinks.astro";

// Left column of the homepage: logo, name (the only h1), role, intro, index, social links.
// From 1024px it stays fixed while the content scrolls; below it becomes the page header.
// On short windows (short:) the spacing tightens, and if the column still does not fit it scrolls on
// its own instead of cutting off the index and the social links. The horizontal padding keeps focus
// rings inside the scroll box.
interface Props {
	name: string;
	role: string;
	intro: string;
	items: readonly IndexItem[];
}

const { name, role, intro, items } = Astro.props;
---

<header
	class="flex min-w-0 flex-[1_1_var(--container-column-left)] flex-col justify-between gap-10 pt-16 pb-4 lg:sticky lg:top-0 lg:-mx-3 lg:h-screen lg:overflow-y-auto lg:overscroll-contain lg:px-3 lg:py-24 lg:[scrollbar-width:thin] lg:short:gap-6 lg:short:py-8"
>
	<div>
		<span class="mb-7 inline-flex lg:short:mb-3 size-12 items-center justify-center rounded-logo bg-surface text-text shadow-logo print:shadow-none">
			<Logo size={28} />
		</span>
		<h1 class="text-[42px] leading-[1.05] font-bold tracking-[-0.03em] text-text lg:text-name lg:short:text-[42px]">{name}</h1>
		<p class="mt-3 text-role text-text">{role}</p>
		<p class="mt-4 max-w-[340px] text-lead lg:short:max-w-none">{intro}</p>
		<IndexNav items={items} />
	</div>
	<SocialLinks />
</header>
