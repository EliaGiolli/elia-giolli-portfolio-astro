---
import { externalLinkAttributes } from "../../helpers/links";
import { ANALYTICS_ID } from "../utils/analytics";
import { BLOG_NAME, CONTACT_EMAIL, GITHUB_URL, LINKEDIN_URL, SITE_TAGLINE } from "../utils/constants";

interface Props {
	class?: string;
}

const { class: extraClass } = Astro.props;
const hasAnalytics = Boolean(ANALYTICS_ID);
const links = [
	{ label: "Blog", href: "/blog" },
	{ label: "Case study", href: "/case-studies/" },
	{ label: "CV", href: "/cv/" },
	{ label: "RSS", href: "/rss.xml" },
	{ label: "Email", href: `mailto:${CONTACT_EMAIL}` },
	{ label: "LinkedIn", href: LINKEDIN_URL },
	{ label: "GitHub", href: GITHUB_URL },
	{ label: "Privacy", href: "/privacy" },
];
const linkClass = "inline-flex min-h-11 cursor-pointer items-center text-text-body transition-colors duration-200 hover:text-accent";
---

<footer class:list={["text-small text-text-muted print:hidden", extraClass]}>
	<p class="max-w-[460px]">
		Costruito con Astro, Tailwind CSS e Alpine.js, pubblicato su Vercel. Testi in Figtree. Nessun dato analytics raccolto
		prima del tuo consenso.
	</p>
	<nav class="mt-4" aria-label="Link del footer">
		<ul class="flex list-none flex-wrap gap-x-5 p-0">
			{links.map((link) => (
				<li><a class={linkClass} href={link.href} {...externalLinkAttributes(link.href)}>{link.label}</a></li>
			))}
			{hasAnalytics && (
				<li>
					<button type="button" class={linkClass} x-data x-on:click="$dispatch('open-cookie-preferences')">Preferenze cookie</button>
				</li>
			)}
		</ul>
	</nav>
	<p class="mt-4">&copy; {new Date().getFullYear()} {BLOG_NAME} · {SITE_TAGLINE}</p>
</footer>
