---
// The "index" mark: three entries, the middle one is the active entry.
// Outer bars follow the text colour (currentColor), the middle bar uses the accent token.
interface Props {
	size?: number;
	accent?: string;
	class?: string;
	label?: string;
}

const { size = 32, accent = "var(--color-accent)", class: extraClass, label } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="10 10 28 28"
	width={size}
	height={size}
	class={extraClass}
	fill="none"
	stroke-width="4.5"
	stroke-linecap="round"
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
>
	<path d="M13 15h14" stroke="currentColor"></path>
	<path d="M13 24h22" stroke={accent}></path>
	<path d="M13 33h9" stroke="currentColor"></path>
</svg>
