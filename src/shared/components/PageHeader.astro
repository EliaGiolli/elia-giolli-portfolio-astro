---
import PageContainer from "./PageContainer.astro";

// Header of an inner page: breadcrumbs (slot "before"), kicker, the page h1 and an optional dek.
interface Props {
	kicker: string;
	title: string;
	dek?: string;
	id?: string;
	width?: "page" | "prose";
}

const { kicker, title, dek, id = "page-title", width = "page" } = Astro.props;
---

<header class="pt-10 pb-12 lg:pt-14 lg:pb-16">
	<PageContainer width={width}>
		<slot name="before" />
		<div class="mt-10 max-w-3xl">
			<p class="mb-4 text-toc text-accent uppercase">{kicker}</p>
			<h1 id={id} class="text-[34px] leading-[1.1] font-bold tracking-[-0.03em] text-balance text-text sm:text-[42px] lg:text-name">{title}</h1>
			{dek && <p class="mt-5 max-w-2xl text-lead text-pretty">{dek}</p>}
			<slot />
		</div>
	</PageContainer>
</header>
