---
import { buildCanonicalUrl, buildPageTitle } from "../../helpers";
import {
	BLOG_NAME,
	GOOGLE_SITE_VERIFICATION,
	OG_IMAGE_HEIGHT,
	OG_IMAGE_PATH,
	OG_IMAGE_WIDTH,
	SITE_DESCRIPTION,
	SITE_LOCALE,
	SITE_TAGLINE,
} from "../utils/constants";

export interface SeoProps {
	title?: string;
	description?: string;
	ogType?: "website" | "article" | "profile";
	ogImage?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	noindex?: boolean;
}

type Props = SeoProps;

const {
	title = `${BLOG_NAME} · ${SITE_TAGLINE}`,
	description = SITE_DESCRIPTION,
	ogType = "website",
	ogImage = OG_IMAGE_PATH,
	publishedTime,
	modifiedTime,
	noindex = false,
} = Astro.props;

const pageTitle = buildPageTitle(title, BLOG_NAME);
// Falls back to the dev origin so `astro dev` never emits a canonical pointing at production.
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(ogImage, siteUrl);
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || GOOGLE_SITE_VERIFICATION;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#17252b" />
<link rel="icon" type="image/svg+xml" href="/logo.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${BLOG_NAME} · Blog`} href="/rss.xml" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700;800&display=swap" />

<title>{pageTitle}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonicalUrl.href} />}
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={BLOG_NAME} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
<meta property="og:image:alt" content={`${BLOG_NAME} · ${SITE_TAGLINE}`} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl.href} />
