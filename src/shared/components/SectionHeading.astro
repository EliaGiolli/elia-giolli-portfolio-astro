---
interface Props {
	id: string;
	kicker: string;
	title: string;
	intro?: string;
	tone?: "light" | "dark";
}

const { id, kicker, title, intro, tone = "light" } = Astro.props;
const isDark = tone === "dark";
---

<div class="max-w-2xl">
	<p class:list={["mb-4 text-sm font-bold uppercase tracking-[0.18em]", isDark ? "text-[#f2b84b]" : "text-indigo-600"]}>{kicker}</p>
	<h2 id={id} class:list={["text-3xl font-extrabold tracking-tight sm:text-4xl", isDark ? "text-white" : "text-[#17252b]"]}>{title}</h2>
	{intro && <p class:list={["mt-4 text-lg leading-8", isDark ? "text-slate-300" : "text-slate-600"]}>{intro}</p>}
</div>
